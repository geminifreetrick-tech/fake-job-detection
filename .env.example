# ----- shared -----
SERVICE_TOKEN=change-me-internal-service-token
LOG_LEVEL=INFO

# ----- postgres -----
POSTGRES_USER=fjd
POSTGRES_PASSWORD=fjd_dev_password
POSTGRES_DB=fjd
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- mongodb (optional, phase 1 uses only for prediction logs) -----
MONGO_URL=mongodb://mongodb:27017
MONGO_DB=fjd

# ----- chromadb -----
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ----- auth-mcp -----
JWT_SECRET=change-me-jwt-signing-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Optional: bootstrap an admin user on auth-mcp startup. Leave blank to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ----- ml-engine -----
MODEL_STORE_DIR=/app/model_store
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
TESSERACT_CMD=/usr/bin/tesseract

# ----- backend gateway -----
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_MCP_URL=http://auth-mcp:8700
DB_MCP_URL=http://db-mcp:8500
ML_ENGINE_URL=http://ml-engine:8100
MEMORY_MCP_URL=http://memory-mcp:8200
FILESYSTEM_MCP_URL=http://filesystem-mcp:8400
WEBSEARCH_MCP_URL=http://websearch-mcp:8600
NOTIFICATION_MCP_URL=http://notification-mcp:8300
ANALYTICS_MCP_URL=http://analytics-mcp:8800

# ----- filesystem-mcp -----
UPLOAD_DIR=/app/uploads
REPORTS_DIR=/app/reports
MAX_UPLOAD_BYTES=26214400

# ----- websearch-mcp -----
# Leave blank to use the heuristic-only fallback (no external HTTP calls).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
FALLBACK_WHEN_NO_KEY=true

# ----- notification-mcp -----
# Leave SMTP_HOST blank to log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@fake-job-detection.local
BACKEND_URL=http://backend:8000

# ----- analytics-mcp -----
CACHE_TTL_SECONDS=30
